# Скопировать в .env и заполнить своими значениями. .env в git не попадает.

# Токен от @BotFather
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Свой Telegram ID, узнать у @userinfobot
ADMIN_ID=000000000

# Серверы. is_local=true - тот, на котором крутится бот.
# ssh_key нужен только для остальных: бот ходит на них по ключу.
SERVERS=[{"name":"server1","host":"192.0.2.1","ssh_port":22,"ssh_user":"root","ssh_key":"/root/.ssh/id_ed25519","wg_interface":"awg0","wg_config":"/etc/amnezia/amneziawg/awg0.conf","max_users":15,"is_local":true},{"name":"server2","host":"192.0.2.2","ssh_port":22,"ssh_user":"root","ssh_key":"/root/.ssh/id_ed25519","wg_interface":"awg0","wg_config":"/etc/amnezia/amneziawg/awg0.conf","max_users":15,"is_local":false}]

# --- AmneziaWG: параметры обфускации ---
# Должны совпадать на всех серверах и во всех клиентских конфигах.
# Менять можно, но тогда придётся перевыпустить все ключи.
AWG_JC=5
AWG_JMIN=10
AWG_JMAX=50
AWG_S1=95
AWG_S2=42
AWG_S3=14
AWG_S4=3
AWG_H1=1801680827-1998653040
AWG_H2=2142741064-2144902292
AWG_H3=2146093884-2146220331
AWG_H4=2146616603-2147215006
AWG_I1=<r 2><b 0x858000010001000000000669636c6f756403636f6d0000010001c00c000100010000105a00044d583737>

# --- Hysteria2 ---
# Пароль обфускации salamander. Одинаковый на всех серверах, тот же,
# что передавали в install-hysteria.sh.
# Сгенерировать: openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
HY2_OBFS=ЗАМЕНИТЬ_НА_СВОЙ
HY2_PORT=31000
HY2_HOP=20000-30000

# --- Сеть VPN ---
VPN_SUBNET=10.8.0.0/24
VPN_SERVER_IP=10.8.0.1
DEFAULT_KEY_LIMIT=3
